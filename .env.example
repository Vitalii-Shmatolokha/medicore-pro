# MediCore Pro - Production Environment Variables Template

# Application Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
FLASK_ENV=production
PORT=8000

# Supabase / PostgreSQL Connection String
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/healthcare_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=info
